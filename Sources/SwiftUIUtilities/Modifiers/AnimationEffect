import SwiftUI


struct AnimationEffect {

    struct RippleEffectModifier: ViewModifier {
        @State private var rippleActive = false // Internal state to control the ripple animation
        var animate: Bool // External control for animation
        var color: Color = .blue
        var fade: CGFloat = 0.3
        var duration: Double = 1.0
        var maxScale: CGFloat = 5.0

        func body(content: Content) -> some View {
            ZStack {
                content
                    .overlay(
                        GeometryReader { geo in
                            Circle()
                                .fill(color.opacity(fade))
                                .frame(width: geo.size.width, height: geo.size.height)
                                .scaleEffect(rippleActive ? maxScale : 0.0)
                                .opacity(rippleActive ? 0 : 1)
                                .clipped()
                                .animation(
                                    Animation.easeOut(duration: duration)
                                        .repeatForever(autoreverses: false), value: rippleActive
                                )
                        }
                    )
            }
            .onAppear {
                if animate {
                    // Start the ripple animation when `animate` is true
                    rippleActive = true
                } else {
                    // Stop the ripple effect when `animate` is false
                    rippleActive = false
                }
            }
        }
    }
}
